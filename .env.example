# Flagsmith — point at self-hosted (default) or cloud.
# Cloud demo: FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/  (JS SDK)
#             FLAGSMITH_ADMIN_API_URL=https://api.flagsmith.com/api/v1/ (Management + Node local eval)
#             FLAGSMITH_EVENTS_URL=https://events.api.flagsmith.com/
#             FLAGSMITH_DASHBOARD_URL=https://app.flagsmith.com
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
FLAGSMITH_ADMIN_API_URL=
FLAGSMITH_EVENTS_URL=http://localhost:8000/api/
FLAGSMITH_DASHBOARD_URL=http://localhost:8000

# Client-side environment key (public). Used by the checkout JS SDK.
FLAGSMITH_ENVIRONMENT_KEY=

# Server-side environment key (secret). Used for local evaluation of traffic.
FLAGSMITH_SERVER_KEY=

# Organisation Admin API token (secret). Prefix requests with "Api-Key ".
FLAGSMITH_ADMIN_API_TOKEN=

# Warehouse (required before Flagsmith will create experiments):
# Cloud: Environment Settings → Warehouse → Flagsmith (warehouse_type=flagsmith)
# Self-host: Flagsmith database (warehouse_type=postgres, config.source=flagsmith_database)
#
# Optional: bind to an existing cloud project instead of creating one.
# Org 'Lift' is 42178, project 'Lift' is 56470 on app.flagsmith.com.
FLAGSMITH_ORGANISATION_ID=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
FLAGSMITH_ENVIRONMENT_NAME=Development

# Self-host first-run only (ignored when ADMIN_API_TOKEN is set).
FLAGSMITH_BOOTSTRAP_EMAIL=admin@lift.local
FLAGSMITH_BOOTSTRAP_PASSWORD=lift-dev-password

# Experiment
LIFT_FLAG_NAME=checkout_a11y
LIFT_METRIC_EVENT=checkout_completed
LIFT_SITE_URL=http://127.0.0.1:4174
# Unset = 2 × LIFT_TARGET_ARM_N (fixed-horizon default). Set only to override.
LIFT_TRAFFIC_N=
LIFT_TRAFFIC_SEED=20261126
# Identity prefix for lift-sim-{runId}-{seed}-{n}. Unset = compact UTC timestamp
# (YYYYMMDDHHmmss) so re-runs get fresh identities without a manual bump.
LIFT_RUN_ID=
# Unblocked completion probability (both arms). 0.75 ≈ 70–80% with sampling noise.
LIFT_BASELINE_CONVERT=0.75
# Clamped to exclusive (0.5, 1). 0.95 means keep running unless P(win) ≥ 95% or ≤ 5%.
LIFT_WIN_THRESHOLD=0.95
LIFT_RESULTS_WAIT_MS=420000
# Pre-registered per-arm sample size. Default live run sends 2× this, then one look.
LIFT_TARGET_ARM_N=300
# Optional stopping (peek at P(win) and send more traffic). Off by default — it
# inflates false-positive rate. Cap extra traffic with LIFT_MAX_ARM_N.
LIFT_CONTINUE_UNTIL=false
LIFT_MAX_ARM_N=600
LIFT_APPEND_VISITS=false
# Assumption, not measured data: mouse majority with 10% each minority persona.
LIFT_PERSONA_MIX=mouse:0.7,keyboard:0.1,screen-reader:0.1,low-vision:0.1
# Tests may override. Never point this at a live data/state.json.
LIFT_STATE_PATH=

# Honour ?lift_variant= only when true. Playwright --allow-mock and npm run
# experiment overlay this on /config.json in memory; keep false on disk.
LIFT_ALLOW_MOCK=false

# Complete a Flagsmith experiment from local Beta-Binomial math. Default false.
LIFT_ALLOW_LOCAL_DECISION=false
