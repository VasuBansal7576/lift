# Flagsmith — point at self-hosted (default) or cloud.
# Cloud demo: FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
#             FLAGSMITH_EVENTS_URL=https://events.api.flagsmith.com/
#             FLAGSMITH_DASHBOARD_URL=https://app.flagsmith.com
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
FLAGSMITH_EVENTS_URL=http://localhost:8000/api/
FLAGSMITH_DASHBOARD_URL=http://localhost:8000

# Client-side environment key (public). Used by the checkout JS SDK.
FLAGSMITH_ENVIRONMENT_KEY=

# Server-side environment key (secret). Used for local evaluation of traffic.
FLAGSMITH_SERVER_KEY=

# Organisation Admin API token (secret). Prefix requests with "Api-Key ".
FLAGSMITH_ADMIN_API_TOKEN=

# Warehouse (required before Flagsmith will create experiments):
# Cloud: Environment Settings → Warehouse → Flagsmith (warehouse_type=flagsmith)
# Self-host: Flagsmith database (warehouse_type=postgres, config.source=flagsmith_database)
#
# Optional: bind to an existing cloud project instead of creating one.
# Org 'Lift' is 42178, project 'Lift' is 56470 on app.flagsmith.com.
FLAGSMITH_ORGANISATION_ID=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
FLAGSMITH_ENVIRONMENT_NAME=Development

# Self-host first-run only (ignored when ADMIN_API_TOKEN is set).
FLAGSMITH_BOOTSTRAP_EMAIL=admin@lift.local
FLAGSMITH_BOOTSTRAP_PASSWORD=lift-dev-password

# Experiment
LIFT_FLAG_NAME=checkout_a11y
LIFT_METRIC_EVENT=checkout_completed
LIFT_SITE_URL=http://127.0.0.1:4174
LIFT_TRAFFIC_N=120
LIFT_TRAFFIC_SEED=20261126
LIFT_WIN_THRESHOLD=0.95

# Allow ?lift_variant= for Playwright / local bots. Keep false for a live demo
# so assignment only comes from Flagsmith.
LIFT_ALLOW_MOCK=false
