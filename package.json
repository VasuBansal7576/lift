{
  "name": "lift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessibility fixes shipped behind Flagsmith experiments, A/B tested on real conversions.",
  "scripts": {
    "flagsmith:up": "bash scripts/flagsmith-up.sh",
    "flagsmith:down": "docker compose -f docker-compose.flagsmith.yml down",
    "bootstrap": "tsx agent/src/bootstrap.ts",
    "scan": "tsx agent/src/scan.ts",
    "traffic": "tsx traffic/src/runner.ts",
    "decide": "tsx agent/src/decide.ts",
    "verify:pull": "tsx agent/src/verify-pull.ts",
    "experiment": "tsx agent/src/run.ts",
    "fleet": "tsx agent/src/fleet.ts",
    "fleet:estimate": "tsx agent/src/fleet.ts --estimate",
    "site": "tsx scripts/serve-site.ts",
    "dashboard": "tsx scripts/serve-site.ts --dashboard",
    "fleet:rebuild": "tsx agent/src/fleet.ts --rebuild",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:l3-stub": "playwright test tests/e2e/l3-balancer.spec.ts --project=l3-stub",
    "evidence:a": "playwright test -c playwright.evidence.mock.config.ts && playwright test -c playwright.evidence.config.ts && node scripts/collect-evidence-a.mjs",
    "typecheck": "tsc --noEmit",
    "test:all": "vitest run tests/unit && playwright test",
    "l3:bootstrap": "tsx scripts/l3-bootstrap.ts",
    "l3:demo": "tsx scripts/serve-l3.ts",
    "l3:record": "tsx scripts/l3-record.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.1.0",
    "dotenv": "^16.4.7",
    "happy-dom": "^21.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "ajv": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.2"
  }
}
