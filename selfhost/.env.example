# Copy to selfhost/.env (gitignored). Never commit secrets.
# `npm run selfhost:up` writes this file (mode 0600). Leave password blank
# on first run — a random value is generated and stored only here.

# SDK + Admin API (always the compose instance on loopback)
FLAGSMITH_API_URL=http://127.0.0.1:8000/api/v1/
FLAGSMITH_ADMIN_API_URL=http://127.0.0.1:8000/api/v1/
FLAGSMITH_EVENTS_URL=http://127.0.0.1:8000/api/
FLAGSMITH_DASHBOARD_URL=http://127.0.0.1:8000

# CLI origin has no /api/v1 suffix (https://docs.flagsmith.com/integrating-with-flagsmith/CLI)
FLAGSMITH_CLI_API_URL=http://127.0.0.1:8000

# Public client-side environment key (browsers). Safe to put in sites/*/config.json.
FLAGSMITH_ENVIRONMENT_KEY=

# Server-side environment key (secret). Local evaluation only.
FLAGSMITH_SERVER_KEY=

# Organisation Admin API token (secret). Header: Authorization: Api-Key …
FLAGSMITH_ADMIN_API_TOKEN=

FLAGSMITH_ORGANISATION_ID=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
FLAGSMITH_ENVIRONMENT_NAME=Development

# Compose secrets — generated into selfhost/.env (mode 0600) by selfhost:up. Leave blank.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
WAREHOUSE_CREDENTIALS_SECRET=

# First-run only. Leave password empty so selfhost:up generates one.
FLAGSMITH_BOOTSTRAP_EMAIL=admin@lift.local
FLAGSMITH_BOOTSTRAP_PASSWORD=
FLAGSMITH_BOOTSTRAP_FIRST_NAME=Lift
FLAGSMITH_BOOTSTRAP_LAST_NAME=Admin
FLAGSMITH_ORG_NAME=Lift
FLAGSMITH_PROJECT_NAME=Lift
