{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lift.dev/schemas/patch-spec.v0.json",
  "title": "Lift patch spec v0",
  "description": "Declarative, allowlisted DOM patches. Invalid specs are rejected; the runtime fails open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "ops"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "const": 0 },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/$defs/op" }
    }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1 },
    "mountId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "css": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "</\\s*style" },
          { "pattern": "@import" },
          { "pattern": "url\\s*\\(" },
          { "pattern": "expression\\s*\\(" },
          { "pattern": "behavior\\s*:" },
          { "pattern": "-moz-binding" },
          { "pattern": "position\\s*:\\s*(fixed|sticky)" }
        ]
      }
    },
    "safeAttrName": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^([oO][nN]|src$|srcset$|formaction$)" }
    },
    "safeHref": {
      "type": "string",
      "pattern": "^(#|/(?!/|\\\\))(?!.*\\\\).*$"
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector", "name", "value"],
          "properties": {
            "op": { "const": "setAttribute" },
            "selector": { "$ref": "#/$defs/selector" },
            "name": { "$ref": "#/$defs/safeAttrName" },
            "value": { "type": "string" }
          },
          "if": { "properties": { "name": { "const": "href" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/safeHref" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector", "text"],
          "properties": {
            "op": { "const": "setText" },
            "selector": { "$ref": "#/$defs/selector" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "css"],
          "properties": {
            "op": { "const": "injectCSS" },
            "css": { "$ref": "#/$defs/css" },
            "id": { "$ref": "#/$defs/mountId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector", "text"],
          "properties": {
            "op": { "const": "wrapLabel" },
            "selector": { "$ref": "#/$defs/selector" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector"],
          "properties": {
            "op": { "const": "makeFocusable" },
            "selector": { "$ref": "#/$defs/selector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector"],
          "properties": {
            "op": { "const": "bindEnterToClick" },
            "selector": { "$ref": "#/$defs/selector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector", "tag"],
          "properties": {
            "op": { "const": "replaceTag" },
            "selector": { "$ref": "#/$defs/selector" },
            "tag": { "enum": ["button", "label", "span", "a", "p", "strong", "em"] },
            "attributes": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/safeAttrName" },
              "additionalProperties": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector", "position", "html"],
          "properties": {
            "op": { "const": "insertHTML" },
            "selector": { "$ref": "#/$defs/selector" },
            "position": { "enum": ["before", "after", "prepend", "append"] },
            "html": {
              "type": "string",
              "minLength": 1,
              "not": {
                "anyOf": [
                  { "pattern": "<\\s*(script|iframe|object|embed|link|meta|style|form|base|svg|img)\\b" },
                  { "pattern": "\\bon[a-z]+\\s*=" },
                  { "pattern": "javascript:" },
                  { "pattern": "formaction" },
                  { "pattern": "xlink:href" }
                ]
              }
            },
            "mountId": { "$ref": "#/$defs/mountId" }
          }
        }
      ]
    }
  }
}
