{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "agent/**/*.ts",
    "traffic/**/*.ts",
    "tests/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "edge/**/*.ts",
    "orchestrator/**/*.ts"
  ]
}
